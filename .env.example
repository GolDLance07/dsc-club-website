# =============================================================================
# Data Science Club VIT Bhopal — Environment Configuration Blueprint
# =============================================================================
# IMPORTANT:
# - Copy this file to .env and fill in the values.
# - DO NOT commit real secrets or production credentials to Git.
# - .env is explicitly ignored by .gitignore.
# - The frontend application builds and runs gracefully even if Firebase is unconfigured.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Firebase Client Configuration (Web App)
# -----------------------------------------------------------------------------
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# -----------------------------------------------------------------------------
# 2. Firebase Admin SDK Configuration (Server-side Scripts & Cloud Functions ONLY)
# -----------------------------------------------------------------------------
# WARNING: NEVER prefix Admin keys with VITE_ or expose them to the browser!
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Store the downloaded JSON securely and provide its path below:
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_PROJECT_ID=""

# -----------------------------------------------------------------------------
# 3. Appwrite Configuration (Legacy Backend — To Be Decommissioned Post-Migration)
# -----------------------------------------------------------------------------
VITE_APPWRITE_PROJECT_ID=""
VITE_APPWRITE_PROJECT_NAME="dscvitb"
VITE_APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
APPWRITE_API_KEY=""
