# =============================================================================
# Data Science Club VIT Bhopal — Environment Configuration Blueprint
# =============================================================================
# ARCHITECTURE: Firebase Spark (Free Auth & Firestore) + Cloudflare Workers
# - Firebase Spark: Google Authentication + Cloud Firestore database.
# - Cloudflare Workers: Trusted backend for event lifecycle mutations (Zero Blaze billing).
#
# IMPORTANT:
# - Copy this file to .env and fill in the values for local development.
# - DO NOT commit real secrets or production credentials to Git (.env is ignored).
# - NEVER prefix server secrets with VITE_ or expose private keys to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Firebase Client Configuration (Web App — Public Client SDK)
# -----------------------------------------------------------------------------
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="dscvitb-ac7bf.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="dscvitb-ac7bf"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# NOTE: VITE_FIREBASE_STORAGE_BUCKET and event poster storage are omitted/deferred.
# Event management operates through Firestore + Cloudflare Workers, avoiding Firebase Blaze billing.

# -----------------------------------------------------------------------------
# 2. Cloudflare Worker API Configuration (Public Frontend Client)
# -----------------------------------------------------------------------------
# In local development: Leave blank to use Vite's built-in dev proxy/middleware.
# In production: Point to your deployed Cloudflare Worker domain (e.g. https://dsc-event-lifecycle-worker.yourname.workers.dev).
VITE_WORKER_API_URL=""

# -----------------------------------------------------------------------------
# 3. Local Admin SDK (Server Scripts & CLI ONLY — Not for Frontend)
# -----------------------------------------------------------------------------
# Path to downloaded serviceAccountKey.json for scripts/event-lifecycle.mjs and bootstrap.
# Cloudflare Worker secrets (FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY) are configured
# via `npx wrangler secret put`, NEVER stored here in plain text.
FIREBASE_SERVICE_ACCOUNT_PATH=""
SUPER_ADMIN_BOOTSTRAP_EMAIL="president@dscvitb.com"

# -----------------------------------------------------------------------------
# 4. Appwrite Configuration (Legacy Backend — Pending Final Phase 5 Removal)
# -----------------------------------------------------------------------------
VITE_APPWRITE_PROJECT_ID=""
VITE_APPWRITE_PROJECT_NAME="dscvitb"
VITE_APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
APPWRITE_API_KEY=""
