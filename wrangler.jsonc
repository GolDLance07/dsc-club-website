/**
 * DSC VIT Bhopal — Cloudflare Worker Configuration
 *
 * Deploys the trusted event lifecycle API.
 * Free tier compatible (Zero Google Cloud / Firebase Blaze costs).
 * (Event poster storage is deferred.)
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsc-event-lifecycle-worker",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Public Worker Environment Variables (Non-sensitive)
  // To migrate frontend to Cloudflare Pages later, update ALLOWED_ORIGIN below
  // (single origin or comma-separated list during transition, e.g. "https://dscvitb.vercel.app,https://dscvitb.pages.dev")
  "vars": {
    "FIREBASE_PROJECT_ID": "dscvitb-ac7bf",
    "ALLOWED_ORIGIN": "https://dscvitb.vercel.app"
  }

  // SENSITIVE SECRETS:
  // NEVER put secrets in this file or commit them to Git.
  // Set them using Wrangler CLI before deployment:
  //   npx wrangler secret put FIREBASE_CLIENT_EMAIL
  //   npx wrangler secret put FIREBASE_PRIVATE_KEY
}
